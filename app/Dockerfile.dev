FROM python:3.14-slim

WORKDIR /app

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV VIRTUAL_ENV=/venv
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Copied from uv's own image rather than pip-installed, so the dev image never
# carries a second package manager.
COPY --from=ghcr.io/astral-sh/uv:0.13.1 /uv /uvx /bin/
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gettext \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy project files
COPY app/ .

# Install dependencies using uv
RUN uv venv $VIRTUAL_ENV
RUN uv pip install -r requirements.txt

# Expose port for Django development server
EXPOSE 8000

# Same entrypoint as production, so development exercises the secret
# generation, the database wait and the locked migration. compose.dev.yml
# supplies the command.
ENTRYPOINT ["/app/entrypoint.sh"]



