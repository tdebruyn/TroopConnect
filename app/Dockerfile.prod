FROM python:3.14-alpine

# Which release this is, supplied by the image workflow and baked in so a
# running container can be asked. "dev" for a local build. Read by
# troopconnect.settings as TC_APP_VERSION.
ARG TC_APP_VERSION=dev
ENV TC_APP_VERSION=$TC_APP_VERSION

# Set environment variables
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV DJANGO_SETTINGS_MODULE=troopconnect.settings

# Set work directory
WORKDIR /app

# System dependencies. This is an Alpine base, so packages come from apk, and
# psycopg's wheel (psycopg-binary) already bundles libpq. gettext stays because
# `manage.py compilemessages` needs it when a troop regenerates translations.
RUN apk add --no-cache gettext

# Install Python dependencies. The uv binary is copied from its own image, so
# pip never enters the build; gunicorn is installed alongside the pinned
# requirements because it is the runtime command, not an imported library.
COPY --from=ghcr.io/astral-sh/uv:0.13.1 /uv /bin/uv
COPY app/requirements.txt .
RUN uv pip install --system --no-cache -r requirements.txt
RUN uv pip install --system --no-cache gunicorn

# Copy project
COPY app/ .

# Expose port for Gunicorn
EXPOSE 9000

# The entrypoint generates the secrets, waits for the database, and (only for
# the web service, which sets RUN_MIGRATIONS) migrates and collects static
# files. Nothing here is privileged; the stack is driven by compose.yml.
ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["gunicorn", "troopconnect.wsgi:application", "--bind=0.0.0.0:9000", "--workers=4", "--timeout=120"]
