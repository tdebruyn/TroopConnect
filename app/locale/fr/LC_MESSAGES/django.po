msgid "Delete member"
msgstr "Supprimer le membre"

#: members/templates/members/member_delete.html
#, python-format
msgid "Delete %(name)s"
msgstr "Supprimer %(name)s"

#: members/templates/members/member_delete.html
#, python-format
msgid "Deleting %(name)s archives the member. Their account is disabled and they can no longer log in."
msgstr "Supprimer %(name)s archive le membre. Son compte est désactivé et il ne peut plus se connecter."

#: members/templates/members/member_delete.html
msgid "Nothing is destroyed yet: enrolments, payment history and messages are kept, and the member can still be purged later."
msgstr "Rien n'est encore détruit : les inscriptions, l'historique des paiements et les messages sont conservés, et le membre peut encore être purgé plus tard."

#: members/templates/members/member_delete.html
msgid "Enrolments"
msgstr "Inscriptions"

#: members/templates/members/member_purge.html
#, python-format
msgid "Permanently delete %(name)s"
msgstr "Supprimer définitivement %(name)s"

#: members/templates/members/member_purge.html
#, python-format
msgid "This permanently destroys %(name)s and everything still linked to them. This cannot be undone."
msgstr "Cette action détruit définitivement %(name)s et tout ce qui lui est encore lié. Elle est irréversible."

#: members/templates/members/member_purge.html
msgid "Attestation pages that matched this member are kept, but the link to them is cleared."
msgstr "Les attestations liées à ce membre sont conservées, mais le lien vers celui-ci est effacé."

#: members/templates/members/member_purge.html
msgid "Purge an archived member only when the data may really be discarded."
msgstr "Ne purgez un membre archivé que si les données peuvent réellement être supprimées."

