# TroopConnect configuration.
#
# Copy this file to .env and fill in the four required values at the top.
# Nothing else needs editing to get a working instance.
#
#   cp .env.example .env
#   docker compose up -d
#
# `python manage.py check` reports anything missing or malformed, one line per
# variable. See docs/dev/CONTRACT.md for the full reference.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Domain this instance is served from. A bare hostname: no https://, no path,
# no trailing slash. Caddy obtains its TLS certificate for this name, so the
# DNS A/AAAA record must already point at this server on ports 80 and 443.
SITE_DOMAIN=troop.example.org

# Where outgoing mail goes.
#   smtp://user:password@mail.example.org:25         plain SMTP
#   smtp+tls://user:password@mail.example.org:587    STARTTLS (most providers)
#   smtp+ssl://user:password@mail.example.org:465    implicit TLS
#   console://                                       print to the container log
# Percent-encode "@", ":" and "/" in the password, e.g. p@ss -> p%40ss.
EMAIL_URL=smtp+tls://inscriptions@example.org:password@mail.example.org:587

# Address troop mail is sent from. Must be one your provider lets you send as,
# otherwise every message will be rejected or filed as spam.
DEFAULT_FROM_EMAIL=inscriptions@example.org

# Contact address for Let's Encrypt, used by the Caddy container to warn you
# about expiring certificates.
ACME_EMAIL=admin@example.org

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------

# Which release to run. Versions are 0.Y.Z until 1.0, so this defaults to the
# latest 0.x; use 0.4 to take patch releases only, or 0.4.2 to never move. See
# RELEASING.md.
#TC_VERSION=0

# PostgreSQL. DATABASE_URL wins over the POSTGRES_* variables when both are set.
# Set POSTGRES_PASSWORD only if you want to choose the password yourself:
# otherwise one is generated on first start and kept in the secrets volume.
# If you set it after the instance has already started, it is ignored -- the
# database was initialised with the generated one.
#POSTGRES_USER=troopconnect
#POSTGRES_DB=troopconnect
#POSTGRES_PASSWORD=
#POSTGRES_HOST=db
#POSTGRES_PORT=5432
#DATABASE_URL=postgres://troopconnect:password@db:5432/troopconnect

# Secret key. Generated into the secrets volume on first start when unset,
# which is what you want unless you manage secrets elsewhere.
#SECRET_KEY=
#SECRET_KEY_FILE=/data/secrets/secret_key

# Where the first-run wizard's one-time setup code is kept. You do not need to
# set this: the web service issues a code here on the first start of an
# instance that has no administrator, and prints it in its log.
#
#   docker compose logs web | grep -i "setup code"
#
# With the file deleted (or a fresh secrets volume) a new code is issued at the
# next start, which is how you take the wizard back if the old one leaked.
#SETUP_CODE_FILE=/data/secrets/setup_code

# Debug mode. Leave commented out unless you are developing locally: it puts
# Django's debug pages (source code, settings, SQL) on the web.
#DJANGO_DEBUG=0

# Redis, used as the Celery broker and as the cache.
#REDIS_URL=redis://redis:6379/0

# Time zone for dates and scheduled tasks.
#TIME_ZONE=Europe/Brussels

# The troop's name, its languages and its scout-year dates are not environment
# variables: sign in as staff and set them on the settings page. A fresh
# database starts with generic defaults, so set them before families register.

# Let Django serve /media/ itself rather than Caddy serving the volume.
#SERVE_MEDIA_LOCALLY=0

# Social login. Both halves of a pair are required; a provider without keys
# shows no button anywhere on the site.
#GOOGLE_CLIENT_ID=
#GOOGLE_CLIENT_SECRET=
#FACEBOOK_APP_ID=
#FACEBOOK_SECRET=

# Error reporting.
#SENTRY_DSN=
#SENTRY_ENVIRONMENT=production
#SENTRY_RELEASE=

# MailerSend. Setting an API key switches sending to MailerSend's HTTP API and
# takes precedence over EMAIL_URL.
#MAILERSEND_API_KEY=

# Force a mail backend: "mailersend" or "dummy". Anything else follows
# EMAIL_URL.
#MAIL_SEND_MODE=

# Outbound check for newer TroopConnect releases. Off by default, so an
# instance never phones home unless its operator asks it to.
#UPDATE_CHECK=0
#UPDATE_CHECK_URL=https://api.github.com/repos/tdebruyn/TroopConnect/releases/latest

# The django.contrib.sites row allauth reads. Only set this if you migrated an
# instance that already used a row other than 1.
#SITE_ID=1
